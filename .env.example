TZ=UTC
NODE_ENV=development
LOG_LEVEL=info
# Generate with: node ace generate:key
APP_KEY=

# PostgreSQL from docker-compose.yml
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=rag_lab

# Runtime role: not a superuser and not a table owner, so RLS always applies.
DB_APP_USER=rag_app
DB_APP_PASSWORD=rag_app

# Admin role: only for migrations and creating tenants.
DB_ADMIN_USER=rag_admin
DB_ADMIN_PASSWORD=rag_admin

# Must match the embedding model. Changing it means migrating again and
# re-embedding every chunk.
EMBEDDING_DIMENSIONS=1536
