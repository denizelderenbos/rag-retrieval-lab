{
  "name": "rag-retrieval-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node ace test --watch",
    "rag": "node ace rag:demo",
    "test": "node ace test",
    "test:unit": "node ace test unit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "migration:run": "node ace migration:run --connection=admin",
    "migration:fresh": "node ace migration:fresh --connection=admin",
    "db:seed": "node ace db:seed --connection=admin",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "imports": {
    "#contracts/*": "./app/contracts/*.js",
    "#domain/*": "./app/domain/*.js",
    "#services/*": "./app/services/*.js",
    "#repositories/*": "./app/repositories/*.js",
    "#infrastructure/*": "./app/infrastructure/*.js",
    "#retrieval/*": "./app/retrieval/*.js",
    "#tui/*": "./app/tui/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/node": "~26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/lucid": "^22.4.2",
    "ink": "^8.0.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "reflect-metadata": "^0.2.2"
  },
  "allowScripts": {
    "@swc/core": true,
    "esbuild": true,
    "fsevents": true
  },
  "prettier": "@adonisjs/prettier-config",
  "description": "Multi-tenant RAG retrieval layer with PostgreSQL full-text search, pgvector, hybrid search, reranking and Row Level Security (AdonisJS + TypeScript).",
  "engines": {
    "node": ">=22"
  }
}
